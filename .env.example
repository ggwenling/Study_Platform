# Copy to .env at the repository root. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://study_app:CHANGE_ME@127.0.0.1:5432/study_platform
GRAPH_DATABASE_URL=postgresql://study_graph:CHANGE_ME@127.0.0.1:5432/study_platform
# Administrative migration connection; used by Alembic, not by API requests.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/study_platform
# Dedicated disposable integration database, never the application database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/study_platform_test
TEST_GRAPH_DATABASE_URL=postgresql://study_graph:CHANGE_ME@127.0.0.1:5432/study_platform_test

# Model credentials: fill these only in .env; never commit real values.
DEEPSEEK_API_KEY=
# Optional chat fallback: set CHAT_FALLBACK_MODEL to another model on the same DeepSeek endpoint,
# or also set CHAT_FALLBACK_BASE_URL / CHAT_FALLBACK_API_KEY for a different OpenAI-compatible provider.
CHAT_FALLBACK_MODEL=
CHAT_FALLBACK_BASE_URL=
CHAT_FALLBACK_API_KEY=
EMBEDDING_API_KEY=
# Keep disabled unless the held-out RAG evaluation passes; false restores baseline retrieval.
RAG_QUERY_REWRITE_ENABLED=false
# Learning: set true to skip vector retrieval and use heuristic quiz/grade (CI uses this).
LEARNING_STUB_GRADER=false
# Semantic grading threshold; below this verdict becomes pending (default 0.85).
# LEARNING_CONFIDENCE_THRESHOLD=0.85
# LEARNING_LLM_TIMEOUT_SECONDS=45
# LEARNING_LLM_MAX_OUTPUT_TOKENS=2048
# LEARNING_LLM_MAX_RETRIES=2
# Local private storage; relative paths are resolved from the process working directory.
# STORAGE_DIR=D:/Synapse/.local/storage
# Set true for HTTPS deployments.
COOKIE_SECURE=false
# Only enable for local login form testing. Public deployments should keep this false.
LOGIN_DETAILED_ERRORS=false
# Set a random secret of at least 32 bytes for registration and login.
AUTH_JWT_SECRET=
AUTH_PUBLIC_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
