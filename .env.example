# Copy to .env at the repository root. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://study_app:CHANGE_ME@127.0.0.1:5432/study_platform
GRAPH_DATABASE_URL=postgresql://study_graph:CHANGE_ME@127.0.0.1:5432/study_platform
# Administrative migration connection; used by Alembic, not by API requests.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/study_platform
# Dedicated disposable integration database, never the application database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/study_platform_test
TEST_GRAPH_DATABASE_URL=postgresql://study_graph:CHANGE_ME@127.0.0.1:5432/study_platform_test

# Model credentials: fill these only in .env; never commit real values.
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
# Local private storage; relative paths are resolved from the process working directory.
# STORAGE_DIR=D:/Synapse/.local/storage
# Set true for HTTPS deployments.
COOKIE_SECURE=false
