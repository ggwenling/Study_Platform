# KnowLoop 隔离 release 门禁用环境示例。
# 复制到 gitignored 路径后再填写本机值：
#   .local/release-gate/env/release-gate.env
# 本文件不是密钥。CHANGE_ME 与空值故意不能启动就绪服务。
# 禁止把本示例指到生产库、生产端口或已有应用库。

RELEASE_GATE_NAME=release-gate
PGHOST=127.0.0.1
PGPORT=55432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# 只允许 study_release_*_test。拒绝应用主库名、维护库名和模板库名。
RELEASE_DATABASE=study_release_gate_test
RELEASE_RESTORE_DATABASE=study_release_restore_test
RELEASE_MIGRATE_DATABASE=study_release_migrate_test

DATABASE_URL=postgresql+psycopg://study_release_app:CHANGE_ME@127.0.0.1:55432/study_release_gate_test
GRAPH_DATABASE_URL=postgresql://study_release_graph:CHANGE_ME@127.0.0.1:55432/study_release_gate_test
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:55432/study_release_gate_test
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:55432/study_release_gate_test
TEST_GRAPH_DATABASE_URL=postgresql://study_release_graph:CHANGE_ME@127.0.0.1:55432/study_release_gate_test

# 进程从 backend 启动时，相对路径会跟着工作目录走。演练脚本写成仓库内的绝对路径。
# 不得指向仓库其他目录、运行时目录或备份目录。
STORAGE_DIR=.local/release-gate/storage
RELEASE_BACKUP_DIR=.local/release-gate/backups
RELEASE_PID_DIR=.local/release-gate/run

# study-api 固定 8000。隔离栈改用 uvicorn，避免占用本机 8000/5173/5432。
API_HOST=127.0.0.1
API_PORT=18000
WEB_HOST=127.0.0.1
WEB_PORT=15173
SYNAPSE_API_TARGET=http://127.0.0.1:18000
AUTH_PUBLIC_URL=http://127.0.0.1:15173
# 注册接口要求 Origin 在这张表里。只放隔离栈自己的回环来源。
ALLOWED_ORIGINS=["http://127.0.0.1:15173","http://127.0.0.1:18000"]

# 长度不足 32 字节时 /health/ready 返回 503。只在 gitignored 副本里换成随机值。
AUTH_JWT_SECRET=CHANGE_ME
MODEL_CONNECTIONS_KEY=
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
CHAT_FALLBACK_API_KEY=
GOOGLE_CLIENT_SECRET=
SMTP_PASSWORD=

# 默认检索与实验开关。真实质量评测另开批准，不在此环境默认打开。
RAG_QUERY_REWRITE_ENABLED=false
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_LEXICAL_WEIGHT=0
RETRIEVAL_LEXICAL_SCORING=idf
LEARNING_STUB_GRADER=true
COOKIE_SECURE=false
LOGIN_DETAILED_ERRORS=false
RUN_DB_TESTS=1
